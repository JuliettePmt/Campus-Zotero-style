<citation et-al-min="3" et-al-use-first="2" disambiguate-add-names="true" disambiguate-add-givenname="true">
  <layout suffix=".">
  <choose>
    <if position="ibid-with-locator ibid" match="any">
      <text macro="ibid"/>
    </if>
    <else-if position="subsequent">
      <choose>
        <if variable="locator" match="none">
          <text value="Ibid." font-style="italic"/>
        </if>
        <else>
          <text macro="op-cit"/>
        </else>
      </choose>
    </else-if>
    <else-if type="paper-conference" match="any">
      <group delimiter=", ">
      <text macro="author"/>
        <text macro="title"/>
        <text macro="editor" prefix=" dans "/>
        <text macro="title-of-conference-act"/>
        <text macro="conference"/>
        <text variable="issue" prefix="n°"/>
        <date variable="issued" form="text">
          <date-part name="day"/>
          <date-part name="month"/>
          <date-part name="year"/>
        </date>
        <text variable="locator" prefix="p. "/>
      </group>
    </else-if>
    <else>
    <group delimiter=", ">
    <text macro="author"/>
    <text macro="title"/>
    <text macro="collection-editor"/>
    <text macro="translator"/>
    <text macro="edition"/>
    <text macro="pub-place"/>
    <text macro="publisher"/>
    <text macro="collection"/>
    <text macro="conference-name"/>
    <text macro="blog-data"/>
    <group>
    <choose>
    <if type="book thesis standard bill report manuscript" match="any">
      <date date-parts="year" form="text" variable="issued"/>
      <text variable="locator" prefix=", p. "/>
    </if>
    <else-if type="paper-conference" match="any">
      <group delimiter=", ">
        <text macro="conference"/>
        <text variable="issue" prefix="n°"/>
        <date variable="issued" form="text">
          <date-part name="day"/>
          <date-part name="month"/>
          <date-part name="year"/>
        </date>
        <text variable="locator" prefix="p. "/>
      </group>
    </else-if>
    <else-if type="chapter" match="any">
      <date date-parts="year" form="text" variable="issued" suffix=""/>
      <text variable="locator" prefix=", p. "/>
    </else-if>
    <else-if type="article-journal article-magazine article-newspaper" match="any">
      <group delimiter=", ">
        <text variable="volume" prefix="vol. "/>
        <text variable="issue" prefix="n°"/>
        <date variable="issued" form="text">
          <date-part name="day"/>
          <date-part name="month"/>
          <date-part name="year"/>
        </date>
        <text variable="locator" prefix="p. "/>
      </group>
    </else-if>
    <else-if type="paper-conference" match="any">
      <group delimiter=", ">
        <text variable="issue" prefix="n°"/>
        <date variable="issued" form="text">
          <date-part name="day"/>
          <date-part name="month"/>
          <date-part name="year"/>
        </date>
        <text variable="locator" prefix="p. "/>
      </group>
    </else-if>
      <else-if type="webpage webpage post post-weblog" match="any">
        <date variable="issued" form="text">
        <date-part name="day"/>
        <date-part name="month"/>
        <date-part name="year"/>
        </date>
      </else-if>
    </choose>
    </group>
    </group>
    <text macro="publication-history"/>
    <text macro="url"/>
    </else>
  </choose>
  </layout>
</citation>


<bibliography>
  <sort>
    <key macro="author" names-max="3" names-use-first="3"/>
    <key variable="issued" sort="descending"/>
  </sort>
  <layout suffix=".">
    <choose>
      <!-- Cas conférence -->
      <if type="paper-conference" match="any">
        <group delimiter=", ">
          <text macro="author"/>
          <text macro="title"/>
          <text macro="editor" prefix=" dans "/>
          <text macro="title-of-conference-act"/>
          <text macro="conference"/>
          <text variable="issue" prefix="n°"/>
          <date variable="issued" form="text">
            <date-part name="day"/>
            <date-part name="month"/>
            <date-part name="year"/>
          </date>
          <text variable="locator" prefix="p. "/>
        </group>
      </if>
      <else-if type="software">
        <group>
          <date variable="issued" form="text" prefix=", ">
            <date-part name="year"/>
          </date>
        </group>
        <group prefix=". Code du logiciel disponible à l'adresse : ">
          <text macro="URL-software"/>
        </group>
      </else-if>
      <!-- Cas tous les autres types -->
      <else>
        <group delimiter=", ">
          <text macro="author"/>
          <text macro="title"/>
          <text macro="collection-editor"/>
          <text macro="editor"/>
          <text macro="translator"/>
          <text macro="edition"/>
          <text macro="pub-place"/>
          <text macro="publisher"/>
          <text macro="collection"/>
          <text macro="blog-data"/>
        </group>

        <!-- Choix selon le type de document -->
        <choose>
          <if type="book thesis standard bill report manuscript" match="any">
            <group prefix=", ">
            <date date-parts="year" form="text" variable="issued"/>
            </group>
          </if>
          <else-if type="chapter" match="any">
            <group delimiter=", " prefix=", ">
              <date date-parts="year" form="text" variable="issued"/>
              <text variable="locator" prefix="p. "/>
            </group>
          </else-if>
          <else-if type="software">
            <group>
              <date variable="issued" form="text" prefix=", ">
                <date-part name="year"/>
              </date>
            </group>
              <group prefix=". Code du logiciel disponible à l'adresse : ">
              <text macro="URL-software"/>
            </group>
          </else-if>
          <else-if type="article-journal article-magazine article-newspaper" match="any">
            <group delimiter=", " >
              <text variable="volume" prefix=", vol. "/>
              <text variable="issue" prefix="n°"/>
              <date variable="issued" form="text" prefix=", ">
                <date-part name="day"/>
                <date-part name="month"/>
                <date-part name="year"/>
              </date>
            </group>
          </else-if>
          <else-if type="webpage webpage post post-weblog" match="any">
            <date variable="issued" form="text">
              <date-part name="day"/>
              <date-part name="month"/>
              <date-part name="year"/>
            </date>
          </else-if>
        </choose>
      </else>
    </choose>
    <text macro="publication-history"/>
    <text macro="url"/>
  </layout>
</bibliography>


